{
  "name": "@jobflow/db",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./profile": "./src/profile.ts",
    "./resumes": "./src/resumes.ts",
    "./neon": "./src/neon.ts",
    "./jobs": "./src/jobs.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:cloud": "node src/migrate.ts --cloud",
    "collect": "node src/collect-cli.ts"
  },
  "dependencies": {
    "@jobflow/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1"
  }
}
